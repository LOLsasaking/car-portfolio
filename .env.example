# Supabase (optional — site falls back to built-in seed data when absent)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin auth — password for /admin login, secret signs the session cookie
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Cloudinary (image / video / document uploads from admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Anthropic — AI document extraction (optional, regex fallback used when absent)
ANTHROPIC_API_KEY=

# Canonical site URL for SEO / sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
